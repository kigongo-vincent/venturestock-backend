# Application
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=venturestock
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# Authentication
JWT_SECRET=
GOOGLE_CLIENT_ID=

# Flutterwave Standard checkout
# Get these from the Flutterwave dashboard. Never expose the secret key in the mobile app.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_REDIRECT_URL=venturestock://settings/subscription
